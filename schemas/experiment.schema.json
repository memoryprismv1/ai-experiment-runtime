{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/memoryprismv1/ai-experiment-runtime/schemas/experiment.schema.json",
  "title": "AI Experiment Runtime experiment definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "title", "provider", "tasks", "conditions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "system_prompt": {"type": "string"},
    "provider": {
      "type": "object",
      "required": ["type", "model"],
      "properties": {
        "type": {"enum": ["mock", "openai-compatible"]},
        "model": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri"},
        "api_key_env": {"type": "string"},
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 3600}
      },
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "prompt": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "label": {"enum": ["A", "B"]},
          "system_instruction": {"type": "string"},
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path"],
              "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}},
              "additionalProperties": false
            }
          },
          "mock_responses": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "trials_per_task": {"type": "integer", "minimum": 1, "maximum": 100},
    "random_seed": {"type": "integer", "minimum": 0}
  }
}
